# RidePicker environment template.
# Copy to .env.local and fill in real values. Never commit real secrets.
# (.env.example itself is committed; all other .env* files are git-ignored.)

# "mock" (default) runs on the in-browser mock store — no backend required.
# "api" routes services to the real RidePicker Railway backend adapters.
VITE_DATA_MODE=mock

# RidePicker backend base URL. In API mode all real data adapters use this URL.
VITE_RIDEPICKER_API_URL=

# External checkout URL for billing. If empty, checkout is treated as
# "not configured" and the Billing page fails safely instead of navigating
# to a fake URL.
VITE_PAYMENT_URL=

# Show development-only controls (WhatsApp drop simulation, mock billing,
# demo preview). Leave false for production builds.
VITE_ENABLE_DEV_TOOLS=false